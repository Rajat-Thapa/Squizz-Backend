# Local development only. Generate new secrets before deployment.
DATABASE_PASSWORD=squizz-local-db-change-before-deploy
INTERNAL_API_KEY=squizz-local-internal-key-change-before-deploy-32plus
# Origin visitors use for the site. Forms confirmation and unsubscribe links.
# Vite dev server default; use http://localhost:8080 when running the frontend
# repo's Compose stack, or your real domain in production.
PUBLIC_SITE_URL=http://localhost:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Squizz <hello@squizz.test>
